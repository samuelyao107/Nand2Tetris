CHIP PC {
    IN in[16], load, inc, reset;
    OUT out[16];

    PARTS:
  
    Inc16(in=outToInc, out=incOut);

    Mux16(a=outToInc, b=incOut, sel=inc, out=muxIncOut);

    Mux16(a=muxIncOut, b=in, sel=load, out=muxLoadOut);

    Mux16(a=muxLoadOut, b=false, sel=reset, out=muxResetOut);

    Register(in=muxResetOut, load=true, out=out, out=outToInc);
}