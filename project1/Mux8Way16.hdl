CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    Mux4Way16(a=a, b=b, c=c, d=d, sel=sel[1..2], out=out0);
    Mux4Way16(a=e, b=f, c=g, d=h, sel=sel[1..2], out=out1);
    Mux16(a=out0, b=out1, sel=sel[0], out=out);
    
    
}