
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	Mux16(a= instruction, b=outALU, sel=instruction[15], out=AorC);
    
    Not(in=instruction[15], out=loadA0);
    And(a=instruction[15], b=instruction[5], out=loadA1);
    Or(a=loadA0, b=loadA1, out=loadA);
    ARegister(in=AorC, out=AregisterValue, out[0..14]=addressM,  load=loadA);//A register
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=outALU, out=DregisterValue, load=loadD);//D register

    
    Mux16(a=AregisterValue, b=inM, sel=instruction[12], out=AorM);
    ALU(x=DregisterValue, y=AorM, zx=instruction[11], nx=instruction[10], zy=instruction[9], ny=instruction[8], f=instruction[7], no=instruction[6], out=outM,out=outALU, zr=zr, ng=ng);

    Mux(a=false, b=true, sel=instruction[3], out=writeM0);
    And(a=instruction[15], b=writeM0, out=writeM);

    And(a=instruction[1], b=zr, out=loadPC1);
    And(a=instruction[2], b=ng, out=loadPC2);
    
    Not(in=ng, out=ngNot);
    Not(in=zr, out=zrNot);
    And(a=ngNot, b=zrNot, out=strictPos);
    And(a=strictPos, b=instruction[0], out=loadPC3);

    Or(a=loadPC1, b=loadPC2, out=load0);
    Or(a=load0, b=loadPC3, out=loadPC4);

    And(a=instruction[15], b=loadPC4, out=loadPC);

    PC(in=AregisterValue, out[0..14]=pc, load=loadPC, inc=true, reset=reset);
    
    }
  